      "new": {
        "id": "au-an-auto-approved-b-l-whose-tracking-job-",
        "title": "An auto-approved B/L whose tracking job fails or is refused tells nobody",
        "body": "Steps 18 to 19: when an organisation sets a document type to auto_approve, the extraction workflow approves the MBL/HBL itself and then runs the approval hooks, which create the bl_job that the demurrage board reads. runApprovalHooks catches any hook failure and returns it as an 'approval_hook_failed' notice, along with any re-sync the automation refused. The workflow throws that return value away. The reviewer path shows these notices to a person; the automatic path records nothing, notifies no one and creates no task. The document shows as approved, but no tracking job exists, so the 72h demurrage clock is never watched and no one knows it is missing. The workflow's own comment says a swallowed failure means no tracking job. The default policy is review_all, so this only happens for organisations that opt in.",
        "sev": "data",
        "pattern": "handoff-drop",
        "note": "found by zyt-audit (handoff-drop)"
      },
      "evidence": [
        { "file": "apps/server/src/document/workflow.ts", "line": 216, "quote": "await runApprovalHooks(db, documentId);" },
        { "file": "apps/server/src/document/workflow.ts", "line": 214, "quote": "// bl_job), so a swallowed failure means no tracking job — the reason" },
        { "file": "apps/server/src/document/workflow.ts", "line": 196, "quote": "if (autonomy === \"auto_approve\" && decision.outcome === \"auto_approve\") {" }
      ],
      "reason": "handoff-drop defect",
      "chain": false,
      "refute": "holds"
